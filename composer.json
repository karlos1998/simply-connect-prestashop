{
    "name": "simply-connect/prestashop",
    "description": "Official Simply Connect SMS integration for PrestaShop.",
    "type": "prestashop-module",
    "license": "GPL-2.0-or-later",
    "require": {"php": ">=8.1"},
    "require-dev": {"phpunit/phpunit": "^10.5"},
    "autoload": {"psr-4": {"SimplyConnect\\PrestaShop\\": "src/"}},
    "autoload-dev": {"psr-4": {"SimplyConnect\\PrestaShop\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit",
        "check": ["composer validate --strict", "@test"]
    },
    "config": {"sort-packages": true}
}
